# Eternelle — Intelligent Wedding Operations Platform
# Backend Environment Configuration
# Copy this file to .env and fill in your credentials
# ══════════════════════════════════════════════════════

# Supabase PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_EMAILS=
DJANGO_SECRET_KEY=
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Supabase PostgreSQL via Pooler (Transaction mode)
# All team members use the SAME credentials so data is shared
